<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MakerCam.Core\MakerCam.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MakerCam</AssemblyName>
    <RootNamespace>MakerCam.App</RootNamespace>
    <ApplicationIcon>Assets\MakerCam.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.6</Version>
    <Product>MakerCam</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MakerCam.ico" />
  </ItemGroup>

</Project>
