<Window x:Class="MakerCam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MakerCam.App"
        Title="MakerCam Modern"
        Icon="Assets/MakerCam.ico"
        Width="1320" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="6,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Import SVG…" InputGestureText="Ctrl+O" Tag="file-import" Click="Command_Click" />
                <MenuItem Header="_Open project…" Tag="file-open-project" Click="Command_Click" />
                <MenuItem x:Name="RecentFilesMenu" Header="_Recent Files" />
                <Separator />
                <MenuItem Header="_Save project (SVG)" InputGestureText="Ctrl+S" Tag="file-save" Click="Command_Click" />
                <MenuItem Header="_Export G-code…" InputGestureText="Ctrl+E" Tag="file-export" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_New project" Tag="file-new" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Tag="edit-undo" Click="Command_Click" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Tag="edit-redo" Click="Command_Click" />
                <Separator />
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Tag="edit-selectall" Click="Command_Click" />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Tag="edit-copy" Click="Command_Click" />
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Tag="edit-paste" Click="Command_Click" />
                <MenuItem Header="De_lete" InputGestureText="Del" Tag="edit-delete" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Scale…" Tag="edit-scale" Click="Command_Click" />
                <MenuItem Header="_Rotate…" Tag="edit-rotate" Click="Command_Click" />
                <MenuItem Header="S_kew…" Tag="edit-skew" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Preferences…" Tag="edit-preferences" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="_Insert">
                <MenuItem Header="_Circle…" Tag="insert-circle" Click="Command_Click" />
                <MenuItem Header="_Ellipse…" Tag="insert-ellipse" Click="Command_Click" />
                <MenuItem Header="_Rectangle…" Tag="insert-rectangle" Click="Command_Click" />
                <MenuItem Header="_Rounded rectangle…" Tag="insert-roundedrect" Click="Command_Click" />
                <MenuItem Header="_Polygon…" Tag="insert-polygon" Click="Command_Click" />
                <MenuItem Header="_Star…" Tag="insert-star" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="_CAM">
                <MenuItem Header="_Profile…" Tag="cam-profile" Click="Command_Click" />
                <MenuItem Header="P_ocket…" Tag="cam-pocket" Click="Command_Click" />
                <MenuItem Header="_Follow path…" Tag="cam-follow" Click="Command_Click" />
                <MenuItem Header="_Drill…" Tag="cam-drill" Click="Command_Click" />
                <MenuItem Header="Holes along _path…" Tag="cam-drillpath" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Add tabs…" Tag="cam-tabs" Click="Command_Click" />
                <MenuItem Header="_Regenerate all toolpaths" Tag="cam-regenerate" Click="Command_Click" />
                <MenuItem Header="Delete selected _operation" Tag="cam-delete" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="_Toolpaths">
                <MenuItem Header="_Export G-code…" Tag="toolpaths-export" Click="Command_Click" />
                <MenuItem Header="Show / hide _toolpaths" Tag="toolpaths-toggle" Click="Command_Click" />
                <MenuItem Header="Show tool _diameter" Tag="toolpaths-diameter" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Fit view to drawing" Tag="toolpaths-refit" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="Nes_ting">
                <MenuItem Header="Set material _boundary" Tag="nest-boundary" Click="Command_Click" />
                <MenuItem Header="_Nest toolpaths…" Tag="nest-run" Click="Command_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Load e_xample project" Tag="help-example" Click="Command_Click" />
                <MenuItem Header="Quick _guide" Tag="help-guide" Click="Command_Click" />
                <MenuItem Header="_About" Tag="help-about" Click="Command_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ToggleButton x:Name="ToolSelect" Content="Select" Style="{StaticResource ToolToggle}"
                                  Tag="tool-select" Click="Command_Click" />
                    <ToggleButton x:Name="ToolPan" Content="Pan" Style="{StaticResource ToolToggle}"
                                  Tag="tool-pan" Click="Command_Click" />
                    <ToggleButton x:Name="ToolPen" Content="Pen" Style="{StaticResource ToolToggle}"
                                  Tag="tool-pen" Click="Command_Click" />
                    <Rectangle Width="1" Fill="{StaticResource BorderBrushSoft}" Margin="9,2,9,2" />
                    <Button Content="Fit" Style="{StaticResource ToolbarButton}" Tag="view-fit" Click="Command_Click" />
                    <Button Content="−" Style="{StaticResource ToolbarButton}" Tag="view-zoomout" Click="Command_Click" MinWidth="30" />
                    <Button Content="+" Style="{StaticResource ToolbarButton}" Tag="view-zoomin" Click="Command_Click" MinWidth="30" />
                    <Rectangle Width="1" Fill="{StaticResource BorderBrushSoft}" Margin="9,2,9,2" />
                    <ToggleButton x:Name="GridToggle" Content="Grid" Style="{StaticResource ToolToggle}"
                                  Tag="toggle-grid" Click="Command_Click" />
                    <ToggleButton x:Name="SnapToggle" Content="Snap" Style="{StaticResource ToolToggle}"
                                  Tag="toggle-snap" Click="Command_Click" />
                    <ToggleButton x:Name="PathsToggle" Content="Paths" Style="{StaticResource ToolToggle}"
                                  Tag="toggle-toolpaths" Click="Command_Click" />
                    <ToggleButton x:Name="CutterToggle" Content="Cutter" Style="{StaticResource ToolToggle}"
                                  Tag="toggle-diameter" Click="Command_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Units" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="UnitSelect" Width="76" Style="{StaticResource ComboStyle}"
                              SelectionChanged="UnitSelect_SelectionChanged">
                        <ComboBoxItem Content="mm" Tag="mm" />
                        <ComboBoxItem Content="in" Tag="in" />
                    </ComboBox>
                    <Button Content="Panel" Style="{StaticResource ToolbarButton}" Tag="toggle-panel"
                            Click="Command_Click" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusCoords" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusZoom" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="StatusSelection" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="StatusHint" Grid.Column="3" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"
                           Text="Ready" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="310" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" x:Name="CanvasHost" ClipToBounds="True">
                <local:DrawingCanvas x:Name="Canvas" />

                <Border x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="26" Width="430">
                    <StackPanel>
                        <TextBlock Text="Start a project" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Import an SVG drawing or insert a shape, then select paths and add a CAM operation."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="Import SVG" Style="{StaticResource PrimaryButton}"
                                    Tag="file-import" Click="Command_Click" Margin="0,0,8,0" />
                            <Button Content="Insert shape" Style="{StaticResource FlatButton}"
                                    Tag="insert-shape" Click="Command_Click" Margin="0,0,8,0" />
                            <Button Content="Load example" Style="{StaticResource FlatButton}"
                                    Tag="help-example" Click="Command_Click" />
                        </StackPanel>
                        <TextBlock Text="Tip: drag to select, wheel to zoom, hold Space to pan. Press Esc to dismiss this card."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" MaxWidth="420" />
            </Grid>

            <Border Grid.Column="1" x:Name="Sidebar"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,14,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Toolpaths" Style="{StaticResource SidebarHeader}" />
                            <TextBlock x:Name="OpCount" Text="No operations yet" Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Add" Style="{StaticResource FlatButton}"
                                Tag="add-op" Click="Command_Click" VerticalAlignment="Top" />
                    </Grid>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,0" Padding="14,12">
                        <StackPanel>
                            <Button x:Name="ExportButton" Content="Export G-code"
                                    Style="{StaticResource PrimaryButton}" Tag="file-export"
                                    Click="Command_Click" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="SidebarHint"
                                       Text="Tip: click a path to select it. Shift-click adds to the selection."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,0,10,10">
                        <StackPanel x:Name="OpList" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
