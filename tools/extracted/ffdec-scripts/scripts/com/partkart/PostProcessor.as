package com.partkart
{
   import flash.geom.Point;
   
   public class PostProcessor
   {
      
      internal var cutlist:Array;
      
      internal var output:String;
      
      internal var cutteron:Boolean = false;
      
      internal var tools:Array;
      
      internal var currenttool:int;
      
      public function PostProcessor(cuts:Array)
      {
         super();
         this.cutlist = cuts;
      }
      
      public function process() : String
      {
         var cut:* = undefined;
         if(this.cutlist.length == 0)
         {
            return null;
         }
         this.output = "(Generated by PartKam Version 0.05)\r\n\r\n";
         if(Global.unit == "in")
         {
            this.output += "G20 G90 G40\r\n";
         }
         else
         {
            this.output += "G21 G90 G40\r\n";
         }
         this.tools = new Array();
         for each(cut in this.cutlist)
         {
            if(this.tools.indexOf(cut.tooldiameter) == -1)
            {
               this.tools.push(cut.tooldiameter);
            }
         }
         this.tools.sort(Array.NUMERIC | Array.DESCENDING);
         this.currenttool = -1;
         for each(cut in this.cutlist)
         {
            if(cut.processed != false)
            {
               if(cut is ProfileCutObject)
               {
                  this.output += this.processProfile(cut);
               }
               else if(cut is PocketCutObject)
               {
                  this.output += this.processPocket(cut);
               }
               else if(cut is FollowPathCutObject)
               {
                  this.output += this.processFollowPath(cut);
               }
               else if(cut is DrillCutObject)
               {
                  this.output += this.processDrill(cut);
               }
            }
         }
         this.output += "G0 Z" + cut.safetyheight + "\r\n";
         this.output += "M5\r\n";
         this.output += "M30\r\n";
         return this.output;
      }
      
      protected function processProfile(cut:ProfileCutObject) : String
      {
         var loop:CutPath = null;
         var seglist:Array = null;
         var X:Number = NaN;
         var Y:Number = NaN;
         var slice:String = null;
         var surface:Number = NaN;
         var depth:Number = NaN;
         var target:Number = NaN;
         var stepdown:Number = NaN;
         var splitcut:CutPath = null;
         var tool:int = this.tools.indexOf(cut.tooldiameter);
         var factor:int = 10 * Math.ceil(1 / Global.tolerance);
         if(factor < 1)
         {
            factor = 1;
         }
         var loops:Array = cut.rootpath.getChildren();
         if(loops.length == 0)
         {
            return "";
         }
         var profile:String = "\r\n(" + cut.name + ")\r\n";
         for each(loop in loops)
         {
            seglist = loop.seglist;
            if(seglist.length != 0)
            {
               profile += "G0 Z" + cut.safetyheight + "\r\n";
               if(tool != this.currenttool)
               {
                  profile += "T" + tool + " M6\r\n";
                  this.currenttool = tool;
               }
               if(this.cutteron == false)
               {
                  profile += "G17\r\n";
                  profile += "M3\r\n";
                  this.cutteron = true;
               }
               X = seglist[0].p1.x + cut.docx;
               Y = seglist[0].p1.y - cut.docy;
               if(Global.unit == "cm")
               {
                  X *= 10;
                  Y *= 10;
               }
               profile += "G0 X" + Global.toFixed(X,factor) + " Y" + Global.toFixed(Y,factor) + "\r\n";
               surface = Global.toFixed(cut.stocksurface,factor);
               depth = surface;
               target = Global.toFixed(cut.targetdepth,factor);
               stepdown = Global.toFixed(cut.stepdown,factor);
               splitcut = loop.processTabs();
               while(depth > target)
               {
                  depth -= stepdown;
                  if(depth < target)
                  {
                     depth = target;
                  }
                  depth = Global.toFixed(depth,factor);
                  slice = this.getLoopGcode(splitcut,cut.feedrate,cut.docx,cut.docy,depth,cut.targetdepth,cut.plungerate);
                  profile += "G1 Z" + depth + " F" + cut.plungerate + "\r\n";
                  profile += slice;
               }
            }
         }
         return profile;
      }
      
      protected function processPocket(cut:PocketCutObject) : String
      {
         var prevloop:CutPath = null;
         var X:Number = NaN;
         var Y:Number = NaN;
         var loop:CutPath = null;
         var seglist:Array = null;
         var depthdiff:int = 0;
         var tool:int = this.tools.indexOf(cut.tooldiameter);
         var factor:int = 10 * Math.ceil(1 / Global.tolerance);
         if(factor < 1)
         {
            factor = 1;
         }
         var loops:Array = cut.rootpath.getChildren();
         if(loops.length == 0)
         {
            return "";
         }
         var pocket:String = "\r\n(" + cut.name + ")\r\n";
         var depth:Number = Global.toFixed(cut.stocksurface,factor);
         while(depth > cut.targetdepth)
         {
            depth -= cut.stepdown;
            depth = Global.toFixed(depth,factor);
            if(depth < cut.targetdepth)
            {
               depth = cut.targetdepth;
            }
            prevloop = loops[0];
            for each(loop in loops)
            {
               seglist = loop.seglist;
               if(seglist.length != 0)
               {
                  X = seglist[0].p1.x + cut.docx;
                  Y = seglist[0].p1.y - cut.docy;
                  if(Global.unit == "cm")
                  {
                     X *= 10;
                     Y *= 10;
                  }
                  depthdiff = loop.pocketdepth - prevloop.pocketdepth;
                  if(prevloop != loop && (depthdiff == -1 || depthdiff == 1) && prevloop.parent == loop && loop.getNumChildren() == 1)
                  {
                     pocket += "G1 X" + Global.toFixed(X,factor) + " Y" + Global.toFixed(Y,factor) + " F" + cut.feedrate + "\r\n";
                  }
                  else
                  {
                     pocket += "G0 Z" + cut.safetyheight + "\r\n";
                     if(tool != this.currenttool)
                     {
                        pocket += "T" + tool + " M6\r\n";
                        this.currenttool = tool;
                     }
                     if(this.cutteron == false)
                     {
                        pocket += "G17\r\n";
                        pocket += "M3\r\n";
                        this.cutteron = true;
                     }
                     pocket += "G0 X" + Global.toFixed(X,factor) + " Y" + Global.toFixed(Y,factor) + "\r\n";
                     pocket += "G1 Z" + depth + " F" + cut.plungerate + "\r\n";
                  }
                  prevloop = loop;
                  pocket += this.getLoopGcode(loop,cut.feedrate,cut.docx,cut.docy);
               }
            }
         }
         return pocket;
      }
      
      protected function processFollowPath(cut:FollowPathCutObject) : String
      {
         var loop:CutPath = null;
         var seglist:Array = null;
         var slice:String = null;
         var surface:Number = NaN;
         var depth:Number = NaN;
         var X:Number = NaN;
         var Y:Number = NaN;
         var tool:int = this.tools.indexOf(cut.tooldiameter);
         var factor:int = 10 * Math.ceil(1 / Global.tolerance);
         if(factor < 1)
         {
            factor = 1;
         }
         var loops:Array = cut.rootpath.getChildren();
         if(loops.length == 0)
         {
            return "";
         }
         var follow:String = "\r\n(" + cut.name + ")\r\n";
         for each(loop in loops)
         {
            seglist = loop.seglist;
            if(seglist.length != 0)
            {
               slice = this.getLoopGcode(loop,cut.feedrate,cut.docx,cut.docy);
               surface = Global.toFixed(cut.stocksurface,factor);
               depth = surface;
               while(depth > cut.targetdepth)
               {
                  follow += "G0 Z" + cut.safetyheight + "\r\n";
                  if(tool != this.currenttool)
                  {
                     follow += "T" + tool + " M6\r\n";
                     this.currenttool = tool;
                  }
                  if(this.cutteron == false)
                  {
                     follow += "G17\r\n";
                     follow += "M3\r\n";
                     this.cutteron = true;
                  }
                  X = seglist[0].p1.x + cut.docx;
                  Y = seglist[0].p1.y - cut.docy;
                  if(Global.unit == "cm")
                  {
                     X *= 10;
                     Y *= 10;
                  }
                  follow += "G0 X" + Global.toFixed(X,factor) + " Y" + Global.toFixed(Y,factor) + "\r\n";
                  depth -= cut.stepdown;
                  depth = Global.toFixed(depth,factor);
                  if(depth < cut.targetdepth)
                  {
                     depth = cut.targetdepth;
                  }
                  follow += "G1 Z" + depth + " F" + cut.plungerate + "\r\n";
                  follow += slice;
               }
            }
         }
         return follow;
      }
      
      protected function processDrill(cut:DrillCutObject) : String
      {
         var drillpoint:Point = null;
         var X:Number = NaN;
         var Y:Number = NaN;
         var tool:int = this.tools.indexOf(cut.tooldiameter);
         var factor:int = 10 * Math.ceil(1 / Global.tolerance);
         if(factor < 1)
         {
            factor = 1;
         }
         var dlist:Array = cut.dlist;
         if(dlist.length == 0)
         {
            return "";
         }
         var drill:String = "\r\n(" + cut.name + ")\r\n";
         var surface:Number = Global.toFixed(cut.stocksurface,factor);
         var depth:Number = surface;
         for each(drillpoint in dlist)
         {
            depth = surface;
            drill += "G0 Z" + cut.safetyheight + "\r\n";
            if(tool != this.currenttool)
            {
               drill += "T" + tool + " M6\r\n";
               this.currenttool = tool;
            }
            if(this.cutteron == false)
            {
               drill += "G17\r\n";
               drill += "M3\r\n";
               this.cutteron = true;
            }
            X = drillpoint.x + cut.docx;
            Y = drillpoint.y - cut.docy;
            if(Global.unit == "cm")
            {
               X *= 10;
               Y *= 10;
            }
            drill += "G0 X" + Global.toFixed(X,factor) + " Y" + Global.toFixed(Y,factor) + "\r\n";
            while(depth > cut.targetdepth)
            {
               depth -= cut.stepdown;
               depth = Global.toFixed(depth,factor);
               if(depth < cut.targetdepth)
               {
                  depth = cut.targetdepth;
               }
               drill += "G1 Z" + depth + " F" + cut.plungerate + "\r\n";
               drill += "G1 Z" + surface + " F" + cut.plungerate + "\r\n";
            }
         }
         return drill;
      }
      
      protected function getLoopGcode(cut:CutPath, feedrate:Number, docx:*, docy:*, depth:Number = NaN, targetdepth:Number = NaN, plungerate:Number = NaN) : String
      {
         var tablist:Array = null;
         var tab:Tab = null;
         var X:Number = NaN;
         var Y:Number = NaN;
         var I:Number = NaN;
         var J:Number = NaN;
         var seglist:Array = cut.seglist;
         if(Boolean(cut.tabs && cut.tabs.length > 0 && !isNaN(depth)) && Boolean(!isNaN(targetdepth)) && !isNaN(plungerate))
         {
            tablist = cut.tabs.slice();
            tab = tablist.shift();
         }
         var factor:int = 10 * Math.ceil(1 / Global.tolerance);
         if(factor < 1)
         {
            factor = 1;
         }
         var slice:String = "";
         var feedchanged:Boolean = true;
         for(var i:int = 0; i < seglist.length; i++)
         {
            if(Boolean(tab) && Global.toFixed(tab.tabheight + targetdepth,factor) > depth)
            {
               if(tab.p1 == seglist[i].p1)
               {
                  slice += "G1 Z" + Global.toFixed(tab.tabheight + targetdepth,factor) + " F" + plungerate + "\r\n";
                  feedchanged = true;
               }
               if(tab.p2 == seglist[i].p1)
               {
                  slice += "G1 Z" + depth + " F" + plungerate + "\r\n";
                  feedchanged = true;
                  if(tablist.length == 0)
                  {
                     tab = null;
                  }
                  else
                  {
                     tab = tablist.shift();
                  }
               }
            }
            X = seglist[i].p2.x + docx;
            Y = seglist[i].p2.y - docy;
            X = Number(Global.toFixed(X,factor));
            Y = Number(Global.toFixed(Y,factor));
            if(Global.unit == "cm")
            {
               X *= 10;
               Y *= 10;
            }
            if(seglist[i] is CircularArc && seglist[i].getLength() > Global.tolerance)
            {
               I = seglist[i].center.x - seglist[i].p1.x;
               J = seglist[i].center.y - seglist[i].p1.y;
               I = Number(Global.toFixed(I,factor));
               J = Number(Global.toFixed(J,factor));
               if(Global.unit == "cm")
               {
                  I *= 10;
                  J *= 10;
               }
               if(this.isClockwise(seglist[i]))
               {
                  slice += "G2 X" + X + " Y" + Y + " I" + I + " J" + J;
               }
               else
               {
                  slice += "G3 X" + X + " Y" + Y + " I" + I + " J" + J;
               }
            }
            else
            {
               slice += "G1 X" + X + " Y" + Y;
            }
            if(feedchanged)
            {
               slice += " F" + feedrate + "\r\n";
               feedchanged = false;
            }
            else
            {
               slice += "\r\n";
            }
         }
         return slice;
      }
      
      protected function isClockwise(arc:CircularArc) : Boolean
      {
         var norm1:Point = new Point(arc.p1.x - arc.center.x,arc.p1.y - arc.center.y);
         var norm2:Point = new Point(arc.p2.x - arc.center.x,arc.p2.y - arc.center.y);
         var angle:Number = Global.getAngle(norm1,norm2);
         if(angle < 0)
         {
            return true;
         }
         return false;
      }
   }
}

